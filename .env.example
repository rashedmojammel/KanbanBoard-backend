# PostgreSQL connection string
# For local Postgres, a plain connection string is fine:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kanban?schema=public"

# If you're using Neon (or another serverless/pooled Postgres):
# - DATABASE_URL should be the POOLED connection string (the one with "-pooler" in the host),
#   with `&pgbouncer=true&connect_timeout=15` appended. This tells Prisma's engine not to use
#   long-lived prepared statements against PgBouncer's transaction-mode pooler, which is what
#   causes "Error in PostgreSQL connection: Error { kind: Closed, cause: None }" once a pooled
#   connection is recycled mid-request.
# - DIRECT_URL should be the UNPOOLED connection string (no "-pooler" in the host). Prisma uses
#   this only for `prisma migrate` / `prisma db push`, which need a direct connection.
#
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/db?sslmode=require"

# JWT secret used to sign access tokens - use a long random string in production
JWT_SECRET="change-this-to-a-long-random-secret"

# JWT token expiration (e.g. 1d, 12h, 3600s)
JWT_EXPIRES_IN="1d"

# Port the HTTP server listens on
PORT=3000
